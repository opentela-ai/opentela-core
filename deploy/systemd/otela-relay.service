[Unit]
Description=opentela-core relay (TCP 443)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/relay --key ${CREDENTIALS_DIRECTORY}/key --allow ${CREDENTIALS_DIRECTORY}/allow --listen 0.0.0.0:443
LoadCredential=key:/etc/opentela/relay.key
LoadCredential=allow:/etc/opentela/allow.txt
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
MemoryMax=300M
LimitNOFILE=65536
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
