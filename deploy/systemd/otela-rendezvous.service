[Unit]
Description=opentela-core rendezvous (TCP+UDP 8443)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/rendezvous --key ${CREDENTIALS_DIRECTORY}/key --allow ${CREDENTIALS_DIRECTORY}/allow --listen 0.0.0.0:8443
LoadCredential=key:/etc/opentela/rendezvous.key
LoadCredential=allow:/etc/opentela/allow.txt
DynamicUser=yes
Restart=always
RestartSec=2
MemoryMax=200M
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
